# Copie para `.env.local` (ignorado pelo git) e ajuste conforme o ambiente.

# Base das chamadas do frontend.
# Em dev, "/api" passa pelo proxy do Vite: mesma origem, então CORS não bloqueia.
# Em produção, aponte para a URL pública da API (ex.: https://<serviço>.up.railway.app).
#
# ATENÇÃO: variáveis VITE_* são embutidas no bundle em *build time*. Trocar o valor
# no runtime do serviço não tem efeito — é preciso rebuildar.
VITE_API_URL=/api

# Alvo do proxy do Vite. Só vale em dev e NÃO vai para o bundle (sem prefixo VITE_).
#   mock local: http://localhost:3000   (pnpm api:mock)
#   Railway:    https://<serviço>.up.railway.app
API_PROXY_TARGET=http://localhost:3000
